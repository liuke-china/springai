# ============================================================
# springai 环境变量示例
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会进仓库）
#   cp .env.example .env
# ============================================================

# ---------- 必填：大模型 Chat API Key（MiniMax M3，OpenAI 兼容协议）----------
# 没有它应用起不来，因为这是 ChatClient 的唯一模型来源
# Embedding 也复用这一个 Key（MiniMax embo-01）
MINIMAX_API_KEY=你的_MiniMax_API_Key

# ---------- 可选：Cross-Encoder 重排（RAG 检索阶段用 SiliconFlow bge-reranker-v2-m3）----------
# 不填则 RAG 自动降级为内置的轻量重排（语义排名 + 字面重合），功能不受影响
SILICONFLOW_API_KEY=

# ---------- 可选：邮件发送（EmailTools 演示用，不填则自动走"模拟发送"）----------
# 163 邮箱的 password 是「授权码」不是登录密码
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 可选：PostgreSQL 数据源（本地开发默认即可，按需修改）----------
# 默认连接本地 PG，库名 postgres，账号 postgres，密码 123456
# 若你的 PG 密码不是 123456，改这一行即可
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123456

# ---------- 可选：IMS 只读库（Text-to-SQL 用，需内网权限；不填不影响其它功能）----------
READONLY_DB_ENABLED=true
READONLY_DB_URL=jdbc:postgresql://localhost:5432/postgres
READONLY_DB_USERNAME=ims_readonly
READONLY_DB_PASSWORD=123456

# ---------- 可选：IMS 项目接口（内部系统，需内网权限；不填则 IMS 相关接口不可用）----------
IMS_BASE_URL=http://localhost:8080
IMS_TOKEN=

# ---------- 可选：安全 / 运维开关（均有默认值，一般不用改）----------
# 是否拦截恶意提示注入（true=拦截，false=仅日志告警）
APP_SECURITY_BLOCK_MALICIOUS=true
# 安全 Advisor 总开关（true=开，false=关）
APP_SECURITY_ADVISOR_ENABLED=true
# 运维/知识库管理端点是否暴露（true=暴露，默认 false 关闭）
APP_OPS_ENDPOINTS_ENABLED=false
