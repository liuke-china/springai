# ============================================================
# springai 密钥文件示例（复制为 secrets.properties 并填入真实值）
# secrets.properties 已被 .gitignore 忽略，不会进 GitHub
# 由 application.yml 的 spring.config.import 自动引入，无需 export
# ============================================================

# 必填：MiniMax API Key（Chat + Embedding 共用），没有应用起不来
MINIMAX_API_KEY=你的_MiniMax_API_Key

# 可选：SiliconFlow（RAG Cross-Encoder 重排），不填则 RAG 自动降级
SILICONFLOW_API_KEY=

# 可选：邮件（163 邮箱 password 是授权码不是登录密码）
MAIL_USERNAME=
MAIL_PASSWORD=

# 可选：PostgreSQL（本地默认即可）
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=123456

# 可选：IMS 只读库 / 接口（需内网权限）
READONLY_DB_ENABLED=true
READONLY_DB_URL=jdbc:postgresql://localhost:5432/postgres
READONLY_DB_USERNAME=ims_readonly
READONLY_DB_PASSWORD=123456
IMS_BASE_URL=http://localhost:8080
IMS_TOKEN=
